NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com
JSON_BODY_LIMIT=10mb

# Only set these during controlled first-time doctor provisioning
BOOTSTRAP_DOCTOR=false
DOCTOR_ID=doc_varsha
DOCTOR_EMAIL=doctor@example.com
DOCTOR_PASSWORD=replace-with-a-strong-password

# Run the legacy appointment-to-patient migration only during a controlled deployment
RUN_DATA_MIGRATION=false
