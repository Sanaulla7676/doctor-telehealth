# Server
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Production frontend origins, comma-separated
CORS_ORIGINS=https://drvarshabandi.com,https://www.drvarshabandi.com

# Controlled initial doctor provisioning only
BOOTSTRAP_DOCTOR=false
DOCTOR_ID=doc_varsha
DOCTOR_EMAIL=drvarshabandi@gmail.com
DOCTOR_PASSWORD=replace-during-provisioning

# Data migration from legacy startup logic; keep false after one-time migration
RUN_DATA_MIGRATION=false

# Public URLs
PUBLIC_SITE_URL=https://www.drvarshabandi.com
BACKEND_PUBLIC_URL=https://doctor-telehealth.onrender.com
PASSWORD_RESET_BASE_URL=https://www.drvarshabandi.com

# Consultation confirmation policy
REQUIRE_PAYMENT_FOR_CONFIRM=false

# Follow-up reminder processor (used by scheduler/cron)
CRON_SECRET=replace-with-a-long-random-cron-secret

# Password-reset delivery adapter. Set both in production to send reset links.
PASSWORD_RESET_DELIVERY_URL=
PASSWORD_RESET_DELIVERY_SECRET=

# Optional request-size control
JSON_BODY_LIMIT=10mb

# Payment gateway (future, intentionally unused until enabled)
# CASHFREE_ENVIRONMENT=sandbox
# CASHFREE_API_BASE=https://sandbox.cashfree.com/pg
# CASHFREE_CLIENT_ID=
# CASHFREE_CLIENT_SECRET=
